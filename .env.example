# === AI Provider (Google Gemini) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === Flagsmith Management & MCP ===
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1
FLAGSMITH_MCP_URL=https://mcp.flagsmith.com
# Organisation / Management API key (from Flagsmith -> Organisation Settings -> API Keys)
FLAGSMITH_ORG_API_KEY=

# Optional: auto-discovered from FLAGSMITH_ORG_API_KEY if left blank
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_ID=
# Client/Server SDK key for the target environment (used by demo-app & traffic simulator)
FLAGSMITH_ENVIRONMENT_KEY=

# === Target Repo & GitHub PR Automation ===
TARGET_REPO_PATH=./demo-app
# Optional: GitHub repo in owner/name format (defaults to git origin remote if present)
GITHUB_REPO=

# === Runtime ===
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEMO_APP_PORT=5174
